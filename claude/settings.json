{
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/setup/claude/statusline.sh"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowAllUnixSockets": true
    },
    "filesystem": {
      "allowWrite": [
        ".",
        "/Users/parth/Library/Caches/go-build"
      ],
      "allowRead": [
        "/Users/parth/Library/Caches/go-build"
      ]
    }
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Thinking",
      "Processing",
      "Working"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
}
