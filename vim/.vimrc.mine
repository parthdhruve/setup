"Plugin management
source /Users/parth/setup/vim/plugins.vim

"Leader key
let mapleader = ","

"Key remaps
inoremap jk <ESC>

"Indenting
set autoindent
set expandtab
set tabstop=2
set shiftwidth=2

"Syntax
syntax on

"Page width
set colorcolumn=80

"Line numbers
set number
set relativenumber

"Searching
set hlsearch

"File backups
set noswapfile

"Clipboard integration - yank to both vim registers and system clipboard
set clipboard=unnamed
autocmd TextYankPost * call system('pbcopy', @0)
