# APPLICATION-SPECIFIC ALIASES
source /Users/parth/setup/git/aliases.sh

# GENERAL ALIASES
alias m="mark"
alias lg="ls -a | grep -i"

# FUNCTIONS
up() {
if [ $# -eq 0 ]
  then
    cd ..
    return 0
fi
for level in $(seq 1 $1); do
    cd ..
done
}

mark() {
dirname="/tmp/${$}/"
if ! [ -e $dirname ]
  then
    mkdir $dirname
fi
echo $(pwd) > "${dirname}/${1}"
}

gm() {
filename="/tmp/${$}/${1}"
if ! [ -e $filename ]
  then
    return 1
fi
cd $(cat $filename)
}

# ENVIRONMENT VARIABLES
export PATH="/usr/local/bin:$PATH"

# Vim mode
bindkey -v
export KEYTIMEOUT=10

# Map jk to escape in vim insert mode
bindkey -M viins 'jk' vi-cmd-mode
